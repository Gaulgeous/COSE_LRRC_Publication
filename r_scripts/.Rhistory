colnames(proj_scores) <- comp_labels[seq_len(n_components)]
# Align item metadata if needed
if (!is.null(rownames(proj_scores)) && all(rownames(proj_scores) %in% rownames(items))) {
items_matched <- items[rownames(proj_scores), , drop = FALSE]
} else if (nrow(items) == n_obs) {
items_matched <- items
} else {
items_matched <- head(items, n_obs)
}
# -------------------------------------------------------------------------
# 2. Cluster Mapping & Color Assignment (Guards Against NA Values)
# -------------------------------------------------------------------------
cluster_order <- c("Mechanism-Driven", "Admissibility-Driven", "Provenance-Driven")
# Safely translate raw cluster IDs (e.g., 1, 2, 3 or "Cluster 1") into semantic factors
if (!all(as.character(assigned_clusters) %in% cluster_order)) {
c_ids <- as.numeric(gsub("[^0-9]", "", as.character(assigned_clusters)))
if (any(is.na(c_ids)) && exists("km_fit") && !is.null(km_fit$cluster)) {
c_ids <- km_fit$cluster
}
assigned_clusters <- factor(cluster_order[c_ids], levels = cluster_order)
} else {
assigned_clusters <- factor(as.character(assigned_clusters), levels = cluster_order)
}
# Named color palette strictly matching the cluster levels
